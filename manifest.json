{
    "manifest_version": 3,
    "name": "Cardmarket Highlighter",
    "description": "Resalta términos de búsqueda en Cardmarket para localizar vendedores rápidamente.",
    "version": "1.0.0",
    "homepage_url": "https://github.com/vegekku/cardmarket-extension",
    "permissions": ["storage", "tabs"],
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "content_scripts": [
      {
        "matches": ["*://*.cardmarket.com/*/Products/*"],
        "js": ["content.js"]
      }
    ]
  }
  